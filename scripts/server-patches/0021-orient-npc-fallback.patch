@@ -0,0 +1,11 @@
+/*
+ * Generic read-only conversation for NPCs that have no dedicated script.
+ * The text comes from String.wz/Npc.img (name/func/n0/d0/...).
+ */
+function start() {
+    cm.sendOk(cm.getFallbackTalk());
+}
+
+function action(mode, type, selection) {
+    cm.dispose();
+}
