-                            FilePrinter.printError(FilePrinter.NPC_UNCODED, "NPC " + npc.getName() + "(" + npc.getId() + ") is not coded.");
+                            // NPCs without a dedicated script still get a readable
+                            // String.wz conversation instead of silently doing nothing.
+                            if (!NPCScriptManager.getInstance().start(c, npc.getId(), oid, "fallback_talk", null)) {
+                                FilePrinter.printError(FilePrinter.NPC_UNCODED, "NPC " + npc.getName() + "(" + npc.getId() + ") is not coded.");
+                            }
                             return;
                         } else if(c.getPlayer().getShop() != null) {
                             c.announce(MaplePacketCreator.enableActions());
