@@ -45,6 +45,7 @@
 import server.partyquest.Pyramid;
 import server.partyquest.Pyramid.PyramidMode;
 import server.quest.MapleQuest;
+import tools.FilePrinter;
 import tools.LogHelper;
 import tools.MaplePacketCreator;
 import client.MapleCharacter;
@@ -594,4 +595,58 @@
                 return sbe != SkillBookEntry.UNAVAILABLE ? "    Obtainable through #rquestline#k." : "";
         }
         
+        private static MapleData npcStringData;
+
+        private static synchronized MapleData getNpcStringData() {
+                if (npcStringData == null) {
+                        npcStringData = MapleDataProviderFactory
+                                .getDataProvider(new File(System.getProperty("wzpath") + "/String.wz"))
+                                .getData("Npc.img");
+                }
+                return npcStringData;
+        }
+
+        private String getNpcString(MapleData npcData, String key) {
+                if (npcData == null) {
+                        return null;
+                }
+
+                MapleData value = npcData.getChildByPath(key);
+                if (value == null || value.getData() == null) {
+                        return null;
+                }
+
+                String text = value.getData().toString();
+                return text.isEmpty() ? null : text;
+        }
+
+        public String getFallbackTalk() {
+                try {
+                        MapleData npcImage = getNpcStringData();
+                        MapleData npcData = npcImage == null ? null : npcImage.getChildByPath(Integer.toString(npc));
+                        if (npcData == null) {
+                                return "...";
+                        }
+
+                        String[] talkKeys = {"n0", "d0", "n1", "d1", "n2", "d2"};
+                        for (String key : talkKeys) {
+                                String text = getNpcString(npcData, key);
+                                if (text != null) {
+                                        return text;
+                                }
+                        }
+
+                        String name = getNpcString(npcData, "name");
+                        String func = getNpcString(npcData, "func");
+                        if (name != null) {
+                                return func == null ? name : name + " - " + func;
+                        }
+                } catch (Exception e) {
+                        // A missing String.wz entry must not leave the NPC silent.
+                        FilePrinter.printError(FilePrinter.NPC + npc + "-fallback.txt", e);
+                }
+
+                return "...";
+        }
+
 }
