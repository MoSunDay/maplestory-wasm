+    // A half-alive login server (bind failed, process keeps running) is the
+    // worst outcome of a container restart overlap: channels may be up while
+    // 8484 is dead, and clients simply cannot log in. Retry past the old
+    // instance's shutdown window, then exit so the container supervisor
+    // (restart=unless-stopped) brings the process back cleanly.
+    private static void bindLoginPortWithRetry(IoAcceptor acceptor, int port) {
+        final long[] backoffMs = {1000, 2000, 4000, 8000, 15000};
+        for (int attempt = 0; ; attempt++) {
+            try {
+                acceptor.bind(new InetSocketAddress(port));
+                return;
+            } catch (IOException ex) {
+                if (attempt >= backoffMs.length) {
+                    System.err.println("[SEVERE] Login port " + port + " failed to bind after "
+                            + (attempt + 1) + " attempts; exiting for a clean supervisor restart.");
+                    ex.printStackTrace();
+                    System.exit(1);
+                }
+                System.err.println("[WARN] Login port " + port + " bind attempt " + (attempt + 1)
+                        + " failed (previous instance likely still shutting down); retrying in "
+                        + backoffMs[attempt] + " ms");
+                try {
+                    Thread.sleep(backoffMs[attempt]);
+                } catch (InterruptedException ie) {
+                    Thread.currentThread().interrupt();
+                }
+            }
+        }
+    }
+
+    // Character world cache (worldChars) is loaded once at boot; a world field
+    // edited directly in the DB while the server runs (test setups do this)
+    // otherwise keeps handing out the stale world's channel port, which may
+    // not even be listening. Re-read the authoritative row on char select and
+    // refresh the cache; fall back to the cached value on DB errors.
+    public int getCharacterWorldRefreshed(Integer chrid) {
+        try {
+            Connection con = DatabaseConnection.getConnection();
+            try {
+                PreparedStatement ps = con.prepareStatement("SELECT world FROM characters WHERE id = ?");
+                try {
+                    ps.setInt(1, chrid);
+                    ResultSet rs = ps.executeQuery();
+                    try {
+                        if (rs.next()) {
+                            int worldid = rs.getInt("world");
+                            lgnWLock.lock();
+                            try {
+                                worldChars.put(chrid, worldid);
+                            } finally {
+                                lgnWLock.unlock();
+                            }
+                            return worldid;
+                        }
+                    } finally {
+                        rs.close();
+                    }
+                } finally {
+                    ps.close();
+                }
+            } finally {
+                con.close();
+            }
+        } catch (SQLException e) {
+            System.err.println("[WARN] getCharacterWorldRefreshed(" + chrid
+                    + ") DB read failed, falling back to cached world");
+            e.printStackTrace();
+        }
+        return getCharacterWorld(chrid);
+    }
+
