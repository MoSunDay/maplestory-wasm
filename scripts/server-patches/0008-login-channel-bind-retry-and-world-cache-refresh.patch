+    // Same rationale as the login port: a channel whose port failed to bind
+    // (container restart overlap leaves the old process holding it for a few
+    // seconds) would silently stay dead while the world reports online. Retry
+    // past the overlap window, then abort startup instead of running half-alive.
+    private static void bindWithRetry(IoAcceptor acceptor, int port) {
+        final long[] backoffMs = {1000, 2000, 4000, 8000, 15000};
+        for (int attempt = 0; ; attempt++) {
+            try {
+                acceptor.bind(new InetSocketAddress(port));
+                return;
+            } catch (IOException ex) {
+                if (attempt >= backoffMs.length) {
+                    throw new RuntimeException("Channel bind on port " + port
+                            + " failed after " + (attempt + 1) + " attempts", ex);
+                }
+                System.err.println("[WARN] Channel port " + port + " bind attempt " + (attempt + 1)
+                        + " failed (previous instance likely still shutting down); retrying in "
+                        + backoffMs[attempt] + " ms");
+                try {
+                    Thread.sleep(backoffMs[attempt]);
+                } catch (InterruptedException ie) {
+                    Thread.currentThread().interrupt();
+                }
+            }
+        }
+    }
