# 补丁 0023：建角职业分支（Pirate creator / 失败应答 / useFullAranSkillset）
# 背景：客户端建角界面新增 Aran/Pirate 职业选择（CREATE_CHAR job 0-3，
#       0=Cygnus/1=Explorer/2=Legend(Aran)/3=Pirate）。服务端原先只有
#       job 0-2 分支：Pirate 无 creator；CreateCharHandler 对
#       createCharacter 返回 -1（名字被拒）/-3（槽位满）静默无应答，客户端
#       DeleteCharResponseHandler 本就按建角失败处理（Cosmic 协议），
#       挂起等待直到超时。Aran 任务链脚本读取职业分支开关时引用上游
#       YamlConfig（本 fork 无 YamlConfig，改由 ServerConstants 提供
#       USE_FULL_ARAN_SKILLSET=false），QuestActionManager 暴露同名方法
#       供脚本调用（配套补丁 0024）。
# 改动：① IDs 白名单补 Pirate 起始武器 1482000/1492000（1442079 为上游
#       既有）；② job==3 走新增的 PirateNoviceCreator（10 级海盗配方：
#       AP45/SP1、HP 275/MP 185（九次升级中点近似）、Nautilus 120000000
#       出生、双子武器互赠、2330000 子弹 x1000、4161001 新手指南）；
#       ③ -1/-3 与 -2 一致回 deleteCharResponse(0,9)，客户端恢复建角
#       控件并弹错；④ QuestActionManager.useFullAranSkillset() +
#       import constants.ServerConstants。
# 应用（在 link_repos/MapleStory-Server 检出根目录内；该目录是指向
#   /data/MapleStory-Server 的符号链接，直接用绝对路径）：
#   patch -p1 < /data/maplestory-wasm/scripts/server-patches/0023-character-creation-job-branches.patch
# 验证：改动影响 dist，需重编并重启容器生效——
#   bash posix-compile.sh && docker restart ms-game-server
#   E2E（tools/verify/maplestory-webui/run.mjs）：
#     E2E_CHAR_JOB=pirate → wire 3、出生图 120000000、起始武器 1482000
#     E2E_CHAR_JOB=aran   → wire 2、出生图 914000000、起始武器 1442079
#   grep -n "job == 3" src/net/server/handlers/login/CreateCharHandler.java  # 1 处
#   grep -n "status == -1" src/net/server/handlers/login/CreateCharHandler.java  # 1 处
#   grep -n useFullAranSkillset src/scripting/quest/QuestActionManager.java  # 1 处
# 备注：CreateCharHandler / QuestActionManager 的 orig 侧按本任务已知
#   编辑反向重建（无 .git 基线）；若与上游检出存在漂移，以本补丁的
#   new 侧快照为准。
#
--- a/src/net/server/handlers/login/CreateCharHandler.java
+++ b/src/net/server/handlers/login/CreateCharHandler.java
@@ -36,7 +36,7 @@
 public final class CreateCharHandler extends AbstractMaplePacketHandler {
 
     private final static Set<Integer> IDs = new HashSet<>(Arrays.asList(new Integer[]{
-        1302000, 1312004, 1322005, 1442079,                       // Weapons
+        1302000, 1312004, 1322005, 1442079, 1482000, 1492000,                       // Weapons
         1040002, 1040006, 1040010, 1041002, 1041006, 1041010, 1041011, 1042167,     // Bottom
         1060002, 1060006, 1061002, 1061008, 1062115,                                // Top
         1072001, 1072005, 1072037, 1072038, 1072383,                                // Shoes
@@ -99,12 +99,18 @@
         } else if (job == 2) {
             // Aran
             status = LegendCreator.createCharacter(c, name, face, hair, skin, top, bottom, shoes, weapon, gender);
+        } else if (job == 3) {
+            // Pirate
+            status = PirateNoviceCreator.createCharacter(c, name, face, hair, skin, top, bottom, shoes, weapon, gender);
         } else {
             c.announce(MaplePacketCreator.deleteCharResponse(0, 9));
             return;
         }
 
-        if (status == -2) {
+        if (status == -1 || status == -2 || status == -3) {
+            // -1: name rejected, -2: DB insert failed, -3: no character slot
+            // left. Announce all of them so the client restores its creation
+            // controls instead of waiting for a reply that never comes.
             c.announce(MaplePacketCreator.deleteCharResponse(0, 9));
         }
     }
