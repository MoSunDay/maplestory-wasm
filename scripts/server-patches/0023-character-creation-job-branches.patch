+package client.creator.novice;
+
+import client.MapleClient;
+import client.MapleJob;
+import client.creator.CharacterFactory;
+import client.creator.CharacterFactoryRecipe;
+import client.inventory.Item;
+import client.inventory.MapleInventoryType;
+import server.MapleItemInformationProvider;
+
+/**
+ * Creates a level 10 Pirate directly from the character-creation screen,
+ * matching the Nautilus starter quests (2171-2175, lvmin 10) and the
+ * reqLevel 10 knuckler/pistol starter weapons.
+ */
+public class PirateNoviceCreator extends CharacterFactory {
+
+    // HP/MP follow the pirate branch of MapleCharacter.levelUp: base 50/5 at
+    // level 1 plus nine level-ups of 22-28 HP and 18-23 MP (midpoints used).
+    private static final int STARTING_HP = 50 + 9 * 25;
+    private static final int STARTING_MP = 5 + 9 * 20;
+
+    private static CharacterFactoryRecipe createRecipe(int top, int bottom, int shoes, int weapon) {
+        CharacterFactoryRecipe recipe = new CharacterFactoryRecipe(MapleJob.PIRATE, 10, 120000000, top, bottom, shoes, weapon);
+
+        recipe.setRemainingAp(45);  // levels 2-10 worth of AP, unspent
+        recipe.setRemainingSp(1);
+        recipe.setMaxHp(STARTING_HP);
+        recipe.setMaxMp(STARTING_MP);
+
+        giveItem(recipe, 4161001, 1, MapleInventoryType.ETC);         // beginner guide
+        giveItem(recipe, 2330000, 1000, MapleInventoryType.USE);      // bullets for the pistol
+
+        // Hand over the starter weapon the player did not preview on the
+        // creation screen (1482000 knuckler / 1492000 pistol).
+        int altWeapon = (weapon == 1482000) ? 1492000 : 1482000;
+        giveEquipment(recipe, MapleItemInformationProvider.getInstance(), altWeapon);
+
+        return recipe;
+    }
+
+    private static void giveEquipment(CharacterFactoryRecipe recipe, MapleItemInformationProvider ii, int equipid) {
+        Item nEquip = ii.getEquipById(equipid);
+        recipe.addStartingEquipment(nEquip);
+    }
+
+    private static void giveItem(CharacterFactoryRecipe recipe, int itemid, int quantity, MapleInventoryType itemType) {
+        recipe.addStartingItem(itemid, quantity, itemType);
+    }
+
+    public static int createCharacter(MapleClient c, String name, int face, int hair, int skin, int top, int bottom, int shoes, int weapon, int gender) {
+        return createNewCharacter(c, name, face, hair, skin, gender, createRecipe(top, bottom, shoes, weapon));
+    }
+}
