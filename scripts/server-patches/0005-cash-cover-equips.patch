+    private static void unequipCashCover(MapleClient c, short src, short dst) {
+        MapleCharacter chr = c.getPlayer();
+        MapleInventory cashInv = chr.getInventory(MapleInventoryType.CASH);
+        MapleInventory eqpdInv = chr.getInventory(MapleInventoryType.EQUIPPED);
+
+        Equip cover = (Equip) eqpdInv.getItem(src);
+        if (cover == null) {
+            c.announce(MaplePacketCreator.enableActions());
+            return;
+        }
+        if (dst == 0) {
+            dst = cashInv.getNextFreeSlot();
+        }
+        if (dst <= 0 || cashInv.getItem(dst) != null) {    // clients only drop covers on free CASH slots
+            chr.dropMessage(1, "Inventory full.");
+            c.announce(MaplePacketCreator.enableActions());
+            return;
+        }
+
+        eqpdInv.lockInventory();
+        try {
+            chr.unequippedItem(cover);
+            eqpdInv.removeSlot(src);
+        } finally {
+            eqpdInv.unlockInventory();
+        }
+
+        cover.setPosition(dst);
+        cashInv.addItemFromDB(cover);
+        c.announce(MaplePacketCreator.modifyInventory(true, Collections.singletonList(new ModifyInventory(2, cover, src))));   // MOVE_UNEQUIP
+        chr.equipChanged();
+    }
