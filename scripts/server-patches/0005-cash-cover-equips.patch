+    private static void equipCashCover(MapleClient c, short src, short dst) {
+        MapleCharacter chr = c.getPlayer();
+        MapleInventory cashInv = chr.getInventory(MapleInventoryType.CASH);
+        MapleInventory eqpInv = chr.getInventory(MapleInventoryType.EQUIP);
+        MapleInventory eqpdInv = chr.getInventory(MapleInventoryType.EQUIPPED);
+
+        MapleInventory sourceInv = cashInv;
+        Item item = cashInv.getItem(src);
+        if (item == null) {    // fallback for covers that still sit on the EQUIP tab
+            item = eqpInv.getItem(src);
+            sourceInv = eqpInv;
+        }
+        if (!(item instanceof Equip)) {    // pets and vouchers on the CASH tab cannot be worn
+            c.announce(MaplePacketCreator.enableActions());
+            return;
+        }
+        Equip cover = (Equip) item;
+
+        Equip displaced = (Equip) eqpdInv.getItem(dst);
+        if (displaced != null && cashInv.getNextFreeSlot() < 0) {   // old cover cannot return to the CASH tab, reject the whole operation
+            chr.dropMessage(1, "Inventory full.");
+            c.announce(MaplePacketCreator.getInventoryFull());
+            c.announce(MaplePacketCreator.getShowInventoryFull());
+            return;
+        }
+
+        short displacedDst = 0;
+        if (displaced != null) {
+            displacedDst = cashInv.getNextFreeSlot();
+            eqpdInv.lockInventory();
+            try {
+                chr.unequippedItem(displaced);
+                eqpdInv.removeSlot(dst);
+            } finally {
+                eqpdInv.unlockInventory();
+            }
+        }
+
+        short oldSrc = cover.getPosition();
+        sourceInv.removeSlot(src);
+
+        cover.setPosition(dst);
+        eqpdInv.lockInventory();
+        try {
+            chr.equippedItem(cover);
+            eqpdInv.addItemFromDB(cover);
+        } finally {
+            eqpdInv.unlockInventory();
+        }
+
+        // Each modifyInventory packet carries a single movement byte shared
+        // by all of its mods, so the displacement (MOVE_UNEQUIP) and the
+        // cover being worn (MOVE_EQUIP) must be announced in separate
+        // packets, displacement first: the client then frees the hidden
+        // EQUIP cover slot before the new cover lands in it.
+        if (displaced != null) {
+            displaced.setPosition(displacedDst);
+            cashInv.addItemFromDB(displaced);
+            c.announce(MaplePacketCreator.modifyInventory(true, Collections.singletonList(
+                    new ModifyInventory(2, displaced, dst))));   // MOVE_UNEQUIP back to the CASH tab
+        }
+        c.announce(MaplePacketCreator.modifyInventory(true, Collections.singletonList(
+                new ModifyInventory(2, cover, oldSrc, (byte) 5))));   // oldPos > 0 && newPos <= -100 is read as MOVE_EQUIP by the client; the source tab is CASH
+        chr.equipChanged();
+    }
