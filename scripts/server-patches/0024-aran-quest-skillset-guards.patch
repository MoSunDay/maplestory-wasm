+*/
+importPackage(Packages.client);
+importPackage(Packages.config);
+
+var status = -1;
+
+function end(mode, type, selection) {
+    if (mode == -1) {
+        qm.sendNext("喂！至少说一句你试过了嘛！");
+        qm.dispose();
+    } else {
+        if(mode == 0 && type > 0) {
+            qm.sendNext("喂！至少说一句你试过了嘛！");
+            qm.dispose();
+            return;
+        }
+        
+        if (mode == 1)
+            status++;
+        else
+            status--;
+        
+        if (status == 0)
+            qm.sendNext("先是答应要打倒黑魔法师，让我成为名扬天下的武器，然后把我丢下几百年不管，现在居然跟我说你不记得我是谁？这算什么……？！你以为我会就这么算了？当初苦苦哀求、一心想得到我的人可是你！"); //Giant Polearm
+        else if (status == 1)
+            qm.sendNextPrev("我确实说过，如果我能证明自己的实力，就请 #p1203000# 为我打造一把战枪。", 2);
+        else if (status == 2)
+            qm.sendNextPrev("当初那样苦苦哀求，现在难道不该对我多一点关爱和尊敬吗？要知道，像我这样的武器可是稀有而了不起的存在。我可是能助你打倒黑魔法师的终极 #p1201001#。你怎么能把我丢下几百年不管？");
+        else if (status == 3)
+            qm.sendNextPrev("喂，我可从来没有哀求过要得到你。", 2);
+        else if (status == 4)
+            qm.sendNextPrev("什么？你没有哀求过我？哈！ #p1203000# 告诉我，你当时双膝跪地，流着眼泪哀求要得到我，而且……等等。狂狼勇士！你刚刚是不是想起我是谁了？");
+        else if (status == 5)
+            qm.sendNextPrev("也许想起了一点……", 2);
+        else if (status == 6)
+            qm.sendNextPrev("狂狼勇士，真的是你！*呜呜* 等等，*咳咳* 我才没有感动，只是过敏了而已。我知道黑魔法师夺走了你的能力，你现在恐怕连举起我的力气都没有……但至少你还记得我！你的记忆开始恢复了，我真高兴。");
+        else if (status == 7)
+            qm.sendAcceptDecline("就算你失去了记忆，你也依然是我的主人。你过去经历了非常严苛的修炼，我相信你的身体还记得那些苦日子练就的技巧。好吧，我来恢复你的能力！");
+        else if (status == 8) {
+            if(!qm.isQuestCompleted(21201)) {
+                if(!qm.canHold(1142130)) {
+                    qm.sendOk("哎呀，你的 #b装备#k 栏已经满了。要完成这个任务，你至少得腾出1个空位来。");   // thanks MedicOP for finding an issue here
+                    return;
+                }
+
+                qm.gainItem(1142130, true);
+                qm.changeJobById(2110);
+                
+                if (qm.useFullAranSkillset()) {
+                    qm.teachSkill(21100000, 0, 20, -1);   //polearm mastery
+                    qm.teachSkill(21100002, 0, 30, -1);   //final charge
+                    qm.teachSkill(21100004, 0, 20, -1);   //combo smash
+                    qm.teachSkill(21100005, 0, 20, -1);   //combo drain
+                }
+
+                qm.completeQuest();
+            }
+
+            qm.sendNext("你的等级已经不如全盛时期那么高了，所以我无法恢复你全部的旧能力。不过我恢复的这些应该能帮你更快地升级。快去修炼吧，好让你找回昔日的自己。");    
+        } else if (status == 9) {
+            qm.dispose();
+        }
+    }
+}
