+importPackage(Packages.client);
+importPackage(Packages.config);
+
+var status = -1;
+
+function end(mode, type, selection) {
+    status++;
+    if (mode != 1){
+        if (mode == 0 && type == 1)
+            qm.sendNext("喂！至少说一句你试过了嘛！");
+        qm.dispose();
+        return;
+    }
+    if (status == 0) {
+        qm.sendNext("等等……那不是……你想起红玉的制作方法了？\r\n哇……你虽然又笨又健忘，但正因为这样我才没法抛下你不管。快把红玉交给我吧！"); //Giant Polearm
+    } else if (status == 1) {
+        qm.sendNextPrev("好，既然红玉已经装回我身上了，接下来就让我唤醒你更多的能力吧。我是说，比起上次见面，你的等级已经高了不少，这次我肯定能再多发挥一点魔力！");
+    } else if (status == 2) {
+        if(!qm.isQuestCompleted(21302)) {
+            if(!qm.canHold(1142131)) {
+                qm.sendOk("哎呀，你的 #b装备#k 栏已经满了。要完成这个任务，你至少得腾出1个空位来。");
+                qm.dispose();
+                return;
+            }
+            
+            if(qm.haveItem(4032312, 1)) {
+                qm.gainItem(4032312, -1);
+            }
+            
+            qm.gainItem(1142131, true);
+            qm.changeJobById(2111);
+            
+            if (qm.useFullAranSkillset()) {
+                qm.teachSkill(21110002, 0, 20, -1);   //full swing
+            }
+
+            qm.completeQuest();
+        }
+        
+        qm.sendNext("加油，继续修炼，把你的能力全都找回来，这样我们就能再次一起冒险了！");    
+    } else if (status == 3) {
+        qm.dispose();
+    }
+}
