+importPackage(Packages.client);
+importPackage(Packages.config);
+
+status = -1;
+
+function start(mode, type, selection) {
+    status++;
+    if(mode == 0 && type == 0)
+        status -= 2;
+    else if (mode != 1) {
+        if (mode == 0)
+            qm.sendNext("#b（你需要先冷静想一下……）#k");
+        qm.dispose();
+        return;
+    }
+    if (status == 0) {
+        qm.sendYesNo("#b（你确定自己就是挥舞 #p1201001# 的那位英雄吗？是的，你确定。你最好紧紧握住 #p1201001#。它一定会有所反应的。）#k");
+    } else if (status == 1) {
+        if (qm.getPlayer().getJob().getId() == 2000) {
+            if(!qm.canHold(1142129)) {
+                    qm.sendOk("哎呀，你的 #b装备#k 栏已经满了。要完成这个任务，你至少得腾出1个空位。");
+                    qm.dispose();
+                    return;
+            }
+            qm.gainItem(1142129, true);
+            
+            qm.changeJobById(2100);
+            qm.resetStats();
+            
+            if (qm.useFullAranSkillset()) {
+                qm.teachSkill(21000000, 0, 10, -1);   //combo ability
+                qm.teachSkill(21001003, 0, 20, -1);   //polearm booster
+            }
+            
+            qm.completeQuest();
+
+            //qm.getPlayer().changeSkillLevel(SkillFactory.getSkill(20009000), 0, -1);
+            //qm.getPlayer().changeSkillLevel(SkillFactory.getSkill(20009000), 1, 0);
+            //qm.showInfo("You have acquired the Pig's Weakness skill.");
+            qm.sendNextPrev("#b（你好像开始想起些什么了……）#k", 3);
+        }
+    } else if (status == 2) {
+        //qm.warp(914090100, 0);
+        qm.dispose();
+    }
+}
+
+function end(mode, type, selection) {
+}
