# 服务端源码补丁：QUEST_ACTION action 2/5 完成条件不满足时回 questError 反馈
# 背景：客户端任务闭环（QuestPackets 上行 + UIQuestDialog 兜底）上线后，
#       QuestActionHandler 的 action 2（标准完成）/action 5（脚本完成）在
#       quest.canComplete(player, npc) 为 false 时静默 return，客户端无任何
#       反馈，玩家会误以为提交丢失或客户端卡死。客户端已实现
#       UPDATE_QUEST_INFO 0x0A（MaplePacketCreator.questError，短参 questid）
#       的 UIOk 提示（父仓 src/client/Net/Handlers/QuestHandlers.cpp case 0x0A，
#       文案「任务【名】暂时无法完成，请确认任务条件。」），本补丁补上服务端
#       下发侧：两个完成分支各加 else c.announce(MaplePacketCreator.questError(questid))。
#       action 1/4（接取）不动——客户端 QuestCheck 已前置过滤，且 0x0A 文案
#       语义是"无法完成"。
#
# 应用（在 link_repos/MapleStory-Server 目录内）：
#   patch -p1 < ../../../scripts/server-patches/0018-quest-complete-reject-feedback.patch
# 验证：
#   改动影响 dist：需重编并重启容器生效——
#   bash posix-compile.sh && docker restart ms-game-server
#   客户端提交不满足条件的任务时弹「任务【名】暂时无法完成，请确认任务条件。」
#   grep -n "questError(questid)" src/net/server/channel/handlers/QuestActionHandler.java  # 应有 2 处
#
--- a/src/net/server/channel/handlers/QuestActionHandler.java
+++ b/src/net/server/channel/handlers/QuestActionHandler.java
@@ -28,6 +28,7 @@
 import scripting.quest.QuestScriptManager;
 import server.quest.MapleQuest;
 import server.life.MapleNPC;
+import tools.MaplePacketCreator;
 import tools.data.input.SeekableLittleEndianAccessor;
 
 /**
@@ -88,6 +89,10 @@
                 } else {
                     quest.complete(player, npc);
                 }
+            } else {
+                // 客户端已实现 UPDATE_QUEST_INFO 0x0A 的 UIOk 提示，
+                // 静默 return 会让玩家误以为提交丢失
+                c.announce(MaplePacketCreator.questError(questid));
             }
         } else if (action == 3) {// forfeit quest
             quest.forfeit(player);
@@ -108,6 +113,9 @@
             
             if(quest.canComplete(player, npc)) {
                 QuestScriptManager.getInstance().end(c, questid, npc);
+            } else {
+                // 同 action 2：条件不满足时给客户端一个可见反馈
+                c.announce(MaplePacketCreator.questError(questid));
             }
         }
     }
